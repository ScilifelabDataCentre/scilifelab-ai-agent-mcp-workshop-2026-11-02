// Renovate configuration for this repository
// Extends the custom preset defined in .config/renovate/default.jsonc
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json", // Provides editor autocomplete and validation for Renovate config
  "extends": [
    "github>ScilifelabDataCentre/data-centre-template//.config/renovate/default.jsonc#v1.1.2",
  ],
  "customManagers": [
    // Custom manager to track changes in the development-guidelines repo
    // 1. Look for file .development-guidelines-version in this repo
    // 2. In that file, search for matchStrings pattern
    // 3. If found, extract the currentValue
    // 4. Renovate compares development-guidelines version to currentValue
    // 5. If the values don't match, Renovate treats this as an available update
    // 6. Renovate edits .development-guidelines-version, replacing the old version with the new one, and opens a PR
    // 7. We decide if there's anything to update in this repository in order to comply with the development-guidelines
    {
      "description": "Track development-guidelines releases",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.development-guidelines-version$/"],
      "matchStrings": ["(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "ScilifelabDataCentre/development-guidelines",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
    },
  ],
  "packageRules": [
    {
      "description": "Label development-guidelines tracking updates",
      "matchDepNames": ["ScilifelabDataCentre/development-guidelines"],
      "addLabels": ["dev-guidelines"],
    },
  ],
}
