# Optional local runtime settings. Never commit the copied .env file.
# Pass it with: docker run --env-file .env ...
# Or override each value independently with docker run -e NAME=value ...
OPENLLM_API_KEY=
OPENLLM_BASE_URL=https://openllm.scilifelab.se/api
OPENLLM_MODEL=qwen3
OPENLLM_DISABLE_THINKING=1

# MCP client and server defaults used by the combined image
MCP_URL=http://127.0.0.1:8000/mcp
LITREVIEW_MODE=cache
# MCP_STATE_KEY=

# Optional explicit Jupyter token. If unset, Jupyter generates one in the logs.
# JUPYTER_TOKEN=
